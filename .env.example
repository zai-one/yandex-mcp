# Launcher reference; the service does not auto-load dotenv.
YANDEX_STATE_PATH=state/yandex.sqlite
YANDEX_ACCOUNT_ID=default
YANDEX_LOCAL_PRINCIPAL=local-operator
YANDEX_DIRECT_TOKEN_FILE=secrets/direct.token
YANDEX_DIRECT_CLIENT_LOGIN=
YANDEX_METRIKA_TOKEN_FILE=secrets/metrika.token
YANDEX_SEARCH_API_KEY_FILE=secrets/search.key
YANDEX_SEARCH_FOLDER_ID=example-folder-id
YANDEX_WEBMASTER_TOKEN_FILE=secrets/webmaster.token
YANDEX_AUDIENCE_TOKEN_FILE=secrets/audience.token
YANDEX_MCP_PUBLIC_KEY_FILE=keys/public.pem
YANDEX_MCP_ISSUER=yandex-operator
YANDEX_MCP_AUDIENCE=yandex-mcp
YANDEX_DIRECT_WRITE_ENABLED=false
YANDEX_METRIKA_WRITE_ENABLED=false
YANDEX_WEBMASTER_WRITE_ENABLED=false
YANDEX_AUDIENCE_WRITE_ENABLED=false
YANDEX_WORDSTAT_LIVE_ENABLED=false
YANDEX_WORDSTAT_COST_PER_CALL=0
YANDEX_WORDSTAT_MAX_COST_PER_CALL=0
YANDEX_SEARCH_MAX_COST_PER_APPROVAL=0
YANDEX_PRINCIPAL_MONTHLY_COST_LIMIT=0
YANDEX_ACCOUNT_MONTHLY_COST_LIMIT=0
YANDEX_RATE_LIMIT=10
YANDEX_PRINCIPAL_RATE_LIMIT=10
YANDEX_MAX_CONCURRENCY=2
# Update check: on by default, suggests only, never installs. At startup the server makes
# one anonymous request to api.github.com at most daily (30 min back-off after a failure).
# Set to 1 on servers without internet access or where outbound calls are not allowed.
YANDEX_DISABLE_UPDATE_CHECK=0
# Agent surface (optional; unset = every tool, as before).
# YANDEX_TOOLSETS=default        # all | default | account,direct_read,direct_reports,direct_write,metrika,metrika_write,webmaster,webmaster_write,wordstat,search,audience,audience_write
# YANDEX_TOOLS=                  # extra tools on top of the toolsets
# YANDEX_DISABLED_TOOLS=         # tools to hide
# YANDEX_READ_ONLY=1             # hide every prepare/apply/write/paid-submit tool
