    "direct_apply_changes": {
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "service": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "campaigns": {
            "items": {
              "additionalProperties": true,
