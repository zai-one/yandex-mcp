          }
        },
        "required": [
          "service",
          "method",
          "campaigns",
          "approval_id",
          "idempotency_key"
        ],
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": true,
        "type": "object"
      },
      "description": "Execute one accepted, allowlisted Direct write (Campaigns.update) with readback.\n\nFail-closed: needs the runtime flag, an accepted approval whose hash\nmatches these exact changes, and a bounded allowlisted service/method.\nThe approval is consumed exactly once (idempotency); after the write the\naffected campaigns are re-read to confirm the applied state."
    },
    "direct_write": {
